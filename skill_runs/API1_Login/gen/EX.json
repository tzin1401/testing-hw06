[
 {
  "id": "LG-EX-01",
  "group": "EX",
  "technique": "P3",
  "requirement": "SEC-02",
  "purpose": "P3: token cấp trước khi đặt lại mật khẩu phải bị từ chối sau khi đặt lại",
  "source": "R:43, R:279; A:34-53; GD10",
  "label": "PENDING",
  "label_reason": "",
  "crashes_sut": false,
  "vars": {
   "email": "lg-{{$guid}}@test.com"
  },
  "setup": [
   {
    "name": "đăng ký email",
    "method": "POST",
    "path": "/api/register",
    "body": {
     "name": "LG User",
     "email": "{{email}}",
     "password": "Test1234!"
    },
    "expect_status": 200,
    "capture": {
     "uid": "id"
    }
   },
   {
    "name": "login lấy token cũ",
    "method": "POST",
    "path": "/api/login",
    "body": {
     "email": "{{email}}",
     "password": "Test1234!"
    },
    "expect_status": 200,
    "capture": {
     "old_token": "token"
    }
   },
   {
    "name": "forgot-password",
    "method": "POST",
    "path": "/api/forgot-password",
    "body": {
     "email": "{{email}}"
    },
    "expect_status": 200,
    "capture": {
     "otp": "resetToken"
    }
   },
   {
    "name": "reset-password",
    "method": "POST",
    "path": "/api/reset-password",
    "body": {
     "email": "{{email}}",
     "resetToken": "{{otp}}",
     "newPassword": "NewPass123!"
    },
    "expect_status": 200
   }
  ],
  "request": {
   "method": "GET",
   "path": "/api/users/me",
   "headers": {
    "Authorization": "Bearer {{old_token}}"
   }
  },
  "expect": {
   "status": [
    401,
    403
   ],
   "assumed": true,
   "checks": [
    {
     "path": "id",
     "absent": true
    }
   ]
  }
 },
 {
  "id": "LG-EX-02",
  "group": "EX",
  "technique": "P4",
  "requirement": "SEC-03",
  "purpose": "P4: user đã đăng ký kèm role:\"admin\" thì login vẫn trả role user",
  "source": "R:280, R:67, A:173; GD14",
  "label": "PENDING",
  "label_reason": "",
  "crashes_sut": false,
  "vars": {
   "email": "lg-{{$guid}}@test.com"
  },
  "setup": [
   {
    "name": "đăng ký email",
    "method": "POST",
    "path": "/api/register",
    "body": {
     "name": "LG User",
     "email": "{{email}}",
     "password": "Test1234!",
     "role": "admin"
    },
    "expect_status": 200,
    "capture": {
     "uid": "id"
    }
   }
  ],
  "request": {
   "method": "POST",
   "path": "/api/login",
   "body": {
    "email": "{{email}}",
    "password": "Test1234!"
   },
   "capture": {
    "token": "token"
   }
  },
  "expect": {
   "status": 200,
   "assumed": false,
   "checks": [
    {
     "path": "token",
     "type": "string"
    }
   ]
  },
  "after": [
   {
    "name": "token vừa cấp gọi /api/admin/users → bị từ chối",
    "method": "GET",
    "path": "/api/admin/users",
    "headers": {
     "Authorization": "Bearer {{token}}"
    },
    "expect_status": [
     401,
     403
    ],
    "checks": []
   }
  ]
 },
