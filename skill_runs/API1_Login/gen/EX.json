 {
  "id": "LG-EX-04",
  "group": "EX",
  "technique": "P7",
  "requirement": "FR-02",
  "purpose": "P7: sai 1 lần → login_attempts của user đúng bằng 1",
  "source": "R:41; GD1, GD13",
  "label": "PENDING",
  "label_reason": "",
  "crashes_sut": false,
  "vars": {
   "email": "lg-{{$guid}}@test.com"
  },
  "setup": [
   {
    "name": "đăng ký email",
    "method": "POST",
    "path": "/api/register",
    "body": {
     "name": "LG User",
     "email": "{{email}}",
     "password": "Test1234!"
    },
    "expect_status": 200,
    "capture": {
     "uid": "id"
    }
   },
   {
    "name": "admin login (chỉ đọc)",
    "method": "POST",
    "path": "/api/login",
    "body": {
     "email": "admin@eshop.com",
     "password": "Admin123!"
    },
    "expect_status": 200,
    "capture": {
     "admin_token": "token"
    }
   }
  ],
  "request": {
   "method": "POST",
   "path": "/api/login",
   "body": {
    "email": "{{email}}",
    "password": "Wrong1234!"
   }
  },
  "expect": {
   "status": 401,
   "assumed": true,
   "checks": [
    {
     "path": "token",
     "absent": true
    }
   ]
  },
  "after": [
   {
    "name": "đọc login_attempts qua /api/admin/users",
    "method": "GET",
    "path": "/api/admin/users",
    "headers": {
     "Authorization": "Bearer {{admin_token}}"
    },
    "expect_status": 200,
    "checks": [
     {
      "path": "[id={{uid}}].login_attempts",
      "equals": 1
     }
    ]
   }
  ]
 },
