     "type": "object"
    },
    {
     "path": "user.email",
     "equals": "{{email}}"
    }
   ]
  },
  "after": [
   {
    "name": "dùng token gọi /api/users/me",
    "method": "GET",
    "path": "/api/users/me",
    "headers": {
     "Authorization": "Bearer {{token}}"
    },
    "expect_status": 200,
    "checks": [
     {
      "path": "id",
      "equals": "{{uid}}"
     }
    ]
   }
  ]
