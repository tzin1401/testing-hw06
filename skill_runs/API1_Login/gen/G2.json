     429
    ]
   }
  ],
  "request": {
   "method": "POST",
   "path": "/api/login",
   "body": {
    "email": "{{email}}",
    "password": "Test1234!"
   },
   "capture": {
    "token": "token"
   }
  },
  "expect": {
   "status": 200,
   "assumed": false,
   "checks": [
    {
     "path": "token",
     "type": "string"
    }
   ]
  },
  "after": [
   {
    "name": "dùng token gọi /api/users/me",
    "method": "GET",
    "path": "/api/users/me",
    "headers": {
     "Authorization": "Bearer {{token}}"
    },
    "expect_status": 200,
    "checks": [
     {
      "path": "id",
      "equals": "{{uid}}"
     }
    ]
   }
  ]
